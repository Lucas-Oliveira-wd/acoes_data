incomplete_rows <- !complete.cases(df)
if (any(incomplete_rows)) {
df <- df[complete.cases(df), ]
}
return(df)
}
print(paste('empresas removidas na iteração', n_iter, ':'))
print(wild_row)
n_iter = n_iter+1
df = rmv_na_val(df)
}
return(df)
}
